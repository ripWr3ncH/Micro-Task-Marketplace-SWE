            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin can list users', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const users = pm.response.json();",
                  "const seller = users.find(u => u.email === pm.environment.get('sellerEmail'));",
                  "const buyer = users.find(u => u.email === pm.environment.get('buyerEmail'));",
                  "if (seller) pm.environment.set('sellerUserId', String(seller.id));",
                  "if (buyer) pm.environment.set('buyerUserId', String(buyer.id));"
                ]
              }
            }
          ]
        },
